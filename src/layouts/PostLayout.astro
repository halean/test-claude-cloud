---
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../utils';
import { formatDate, readingTime, slugifyTag, url } from '../utils';

interface Props { post: Post }
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<BaseLayout title={title} description={description} type="article">
  <article>
    <header>
      <a class="back" href={url('blog')}>← All writing</a>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)}</span>
        {updatedDate && <span class="updated">Updated {formatDate(updatedDate)}</span>}
      </div>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => <a class="tag" href={url(`tags/${slugifyTag(tag)}/`)}>#{tag}</a>)}
        </div>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  article > header { margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
  .back { display: inline-block; margin-bottom: 1.5rem; font-size: 0.9rem; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--accent); }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem; color: var(--muted); font-size: 0.95rem; }
  .updated { font-style: italic; }
  .updated::before { content: '('; }
  .updated::after { content: ')'; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
</style>
