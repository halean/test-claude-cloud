---
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../utils';
import { readingTime, slugifyTag, url } from '../utils';

interface Props { post: Post }
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, lang } = post.data;
const stamp = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<BaseLayout title={title} description={description} type="article">
  <article lang={lang}>
    <header>
      <a class="back label" href={url('blog')} lang="en">← Back to the archive</a>
      <div class="file label" lang="en">
        <span>Filed <time datetime={pubDate.toISOString()}>{stamp(pubDate)}</time></span>
        {updatedDate && <span>Amended {stamp(updatedDate)}</span>}
        <span>{readingTime(post.body)}</span>
        <span>Last read: unknown</span>
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => <a class="tag" href={url(`tags/${slugifyTag(tag)}/`)}>{tag}</a>)}
        </div>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
    <p class="end label" lang="en">Nothing further on file.</p>
  </article>
</BaseLayout>

<script>
  // Touch screens have no hover: tap a photo to bring its colour back.
  document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
    img.addEventListener('click', () => img.classList.toggle('recalled'));
  });
</script>

<style>
  article > header { margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
  .back { display: inline-block; margin-bottom: 2rem; text-decoration: none; }
  .back:hover { color: var(--strong); }
  .file { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin-bottom: 0.9rem; }
  .file span:last-child { color: var(--faint); }
  .lede { font-style: italic; font-size: 1.1rem; color: var(--muted); margin: 0 0 1.25rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .end { text-align: center; margin-top: 4rem; color: var(--faint); }
</style>
