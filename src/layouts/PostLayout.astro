---
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../utils';
import { readingTime, slugifyTag, url } from '../utils';

interface Props { post: Post }
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, lang } = post.data;
const stamp = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<BaseLayout title={title} description={description} type="article">
  <article lang={lang}>
    <header>
      <a class="back" href={url('blog')}>&lt; Return to archive</a>
      <div class="file">
        <span>Case file</span>
        <span>Filed <time datetime={pubDate.toISOString()}>{stamp(pubDate)}</time></span>
        {updatedDate && <span>Amended {stamp(updatedDate)}</span>}
        <span>{readingTime(post.body)}</span>
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => <a class="tag" href={url(`tags/${slugifyTag(tag)}/`)}>{tag}</a>)}
        </div>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
    <p class="end label">— End of transmission —</p>
  </article>
</BaseLayout>

<style>
  article > header { margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 2px solid var(--border); }
  .back {
    display: inline-block; margin-bottom: 2rem; font-size: 0.75rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); text-decoration: none;
  }
  .file {
    display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin-bottom: 1rem;
    font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted);
  }
  .file span:first-child { color: var(--accent-ink); background: var(--accent); padding: 0 0.4rem; }
  .file time { color: var(--signal); }
  .lede { font-family: var(--font-serif); font-style: italic; font-size: 1.15rem; color: var(--muted); margin: 0 0 1.25rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .end { text-align: center; margin-top: 4rem; }
</style>
