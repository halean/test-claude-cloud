<button id="theme-toggle" type="button" aria-label="Toggle light and dark" title="Lights on / off">
  <span class="day">Lights off</span><span class="night">Lights on</span>
</button>

<style>
  button {
    font: 0.66rem/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.4rem 0.55rem; border: 1px solid var(--border);
    background: transparent; color: var(--muted); cursor: pointer; white-space: nowrap;
  }
  button:hover { color: var(--strong); border-color: var(--muted); }
  .night { display: none; }
  :global(:root[data-theme='dark']) .day { display: none; }
  :global(:root[data-theme='dark']) .night { display: inline; }
</style>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
