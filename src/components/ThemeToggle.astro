<button id="theme-toggle" type="button" aria-label="Toggle day and night cycle" title="Toggle day / night cycle">
  <span class="day">DAY</span><span class="night">NIGHT</span>
</button>

<style>
  button {
    font: 600 0.68rem/1 var(--font-mono); letter-spacing: 0.12em;
    padding: 0.45rem 0.55rem; border: 1px solid var(--border);
    background: transparent; color: var(--text); cursor: pointer;
  }
  button:hover { background: var(--text); color: var(--bg); }
  .night { display: none; }
  :global(:root[data-theme='dark']) .day { display: none; }
  :global(:root[data-theme='dark']) .night { display: inline; }
</style>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
