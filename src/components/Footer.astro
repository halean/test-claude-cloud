---
import { AUTHOR, SOCIALS } from '../consts';
import { url } from '../utils';
---

<footer class="container">
  <div>
    <span>© {new Date().getFullYear()} {AUTHOR}</span>
    <span class="notice">This terminal is monitored. Reading constitutes consent.</span>
  </div>
  <span class="socials">
    {SOCIALS.map(({ label, href }) => (
      <a href={href.startsWith('http') ? href : url(href)}>{label}</a>
    ))}
  </span>
</footer>

<style>
  footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem;
    margin-top: 6rem; padding-top: 1.5rem; padding-bottom: 3rem;
    border-top: 2px solid var(--border); color: var(--muted);
    font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em;
  }
  footer > div { display: grid; gap: 0.25rem; }
  .notice { color: var(--accent); }
  .socials { display: flex; gap: 1rem; }
  a { color: var(--muted); text-decoration: none; }
  a:hover { color: var(--accent-ink); }
</style>
