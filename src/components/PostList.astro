---
import type { Post } from '../utils';
import { formatDate, readingTime, url } from '../utils';

interface Props { posts: Post[] }
const { posts } = Astro.props;
---

<ul>
  {posts.map((post) => (
    <li>
      <a href={url(`blog/${post.id}/`)}>
        <h3>{post.data.title}{post.data.draft && <span class="draft">Draft</span>}</h3>
        <p>{post.data.description}</p>
        <div class="meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body)}</span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  a {
    display: block; padding: 1.1rem 1.25rem; margin: 0 -1.25rem;
    border-radius: 12px; color: inherit; text-decoration: none;
    transition: background-color 0.15s ease;
  }
  a:hover { background: var(--surface); box-shadow: 0 0 0 1px var(--border); }
  a:hover h3 { color: var(--accent); }
  h3 { margin: 0 0 0.25rem; font-size: 1.15rem; transition: color 0.15s ease; }
  p { margin: 0 0 0.4rem; color: var(--muted); }
  .meta { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--muted); }
  .draft {
    margin-left: 0.5rem; font-size: 0.7rem; vertical-align: middle; padding: 0.1rem 0.45rem;
    border: 1px dashed var(--muted); border-radius: 999px; color: var(--muted);
  }
</style>
