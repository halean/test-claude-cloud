---
import type { Post } from '../utils';
import { readingTime, url } from '../utils';

interface Props { posts: Post[] }
const { posts } = Astro.props;
const stamp = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

{posts.length === 0 && <p class="empty">No records approved for release. Check back after the next review cycle.</p>}
<ol>
  {posts.map((post) => (
    <li>
      <a href={url(`blog/${post.id}/`)}>
        <div class="meta">
          <time datetime={post.data.pubDate.toISOString()}>{stamp(post.data.pubDate)}</time>
          <span>{readingTime(post.body)}</span>
          {post.data.draft && <span class="draft">Unapproved</span>}
        </div>
        <h3>{post.data.title}</h3>
        <p>{post.data.description}</p>
      </a>
    </li>
  ))}
</ol>

<style>
  ol { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--border); }
  li { border-bottom: 1px solid var(--rule); }
  a {
    display: block; padding: 1.25rem 0 1.25rem 1rem; color: inherit; text-decoration: none;
    border-left: 4px solid transparent; transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  a:hover { background: var(--surface); color: inherit; border-left-color: var(--accent); }
  a:hover h3 { color: var(--accent); }
  .meta {
    display: flex; gap: 1rem; font-size: 0.72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted);
  }
  time { color: var(--signal); }
  h3 {
    margin: 0.35rem 0 0.35rem; font-family: var(--font-display); font-weight: 400;
    font-size: 1.6rem; line-height: 1.25; text-transform: uppercase; letter-spacing: 0.01em;
  }
  p { margin: 0; color: var(--muted); font-size: 0.9rem; }
  .empty { padding: 1.5rem 0; color: var(--muted); font-size: 0.85rem; border-top: 1px solid var(--border); }
  ol:empty { display: none; }
  .draft { color: var(--accent); border: 1px dashed var(--accent); padding: 0 0.35rem; }
</style>
