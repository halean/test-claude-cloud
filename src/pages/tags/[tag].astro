---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, slugifyTag, url, type Post } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, { name: string; posts: Post[] }>();
  for (const post of posts) {
    for (const name of post.data.tags) {
      const slug = slugifyTag(name);
      const entry = tags.get(slug) ?? { name, posts: [] };
      entry.posts.push(post);
      tags.set(slug, entry);
    }
  }
  return [...tags].map(([tag, { name, posts }]) => ({ params: { tag }, props: { name, posts } }));
}

const { name, posts } = Astro.props as { name: string; posts: Post[] };
---

<BaseLayout title={`#${name}`} description={`Posts tagged ${name}.`}>
  <a class="back" href={url('tags')}>← All tags</a>
  <h1>#{name}</h1>
  <p class="muted">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  <PostList posts={posts} />
</BaseLayout>

<style>
  .back { display: inline-block; margin-bottom: 1.5rem; font-size: 0.9rem; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--accent); }
</style>
