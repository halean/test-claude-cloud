---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, slugifyTag, url } from '../../utils';

const counts = new Map<string, number>();
for (const post of await getPosts()) {
  for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Subjects" description="Entries by subject.">
  <p class="label">Index</p>
  <h1>Subjects</h1>
  <p class="muted">Entries sorted by subject.</p>
  <div class="cloud">
    {tags.map(([tag, count]) => (
      <a class="tag" href={url(`tags/${slugifyTag(tag)}/`)}>{tag} <span>({count})</span></a>
    ))}
  </div>
</BaseLayout>

<style>
  .cloud { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 2rem; }
  .tag { font-size: 0.85rem; padding: 0.35rem 0.75rem; }
  span { opacity: 0.6; }
</style>
