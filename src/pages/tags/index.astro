---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, slugifyTag, url } from '../../utils';

const counts = new Map<string, number>();
for (const post of await getPosts()) {
  for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags" description="Browse posts by topic.">
  <h1>Tags</h1>
  <p class="muted">Browse posts by topic.</p>
  <div class="cloud">
    {tags.map(([tag, count]) => (
      <a class="tag" href={url(`tags/${slugifyTag(tag)}/`)}>#{tag} <span>{count}</span></a>
    ))}
  </div>
</BaseLayout>

<style>
  .cloud { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 2rem; }
  .tag { font-size: 0.95rem; padding: 0.35rem 0.85rem; }
  span { opacity: 0.6; margin-left: 0.2rem; }
</style>
