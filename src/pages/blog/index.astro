---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../utils';

const posts = await getPosts();
const byYear = Map.groupBy(posts, (post) => post.data.pubDate.getFullYear());
---

<BaseLayout title="Archive" description="Every record on file, newest first.">
  <p class="label">Archive</p>
  <h1>All records</h1>
  <p class="muted">{posts.length} {posts.length === 1 ? 'record' : 'records'} on file. Newest first.</p>
  {[...byYear].map(([year, yearPosts]) => (
    <section>
      <h2 class="label">Cycle {year}</h2>
      <PostList posts={yearPosts} />
    </section>
  ))}
</BaseLayout>

<style>
  h2 { margin: 3rem 0 0.75rem; }
</style>
