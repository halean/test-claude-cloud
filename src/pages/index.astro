---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { HEADLINE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPosts, url } from '../utils';

const allPosts = await getPosts();
const posts = allPosts.slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <p class="label">Transmission {String(allPosts.length).padStart(4, '0')} <span class="sep">//</span> Clearance: public</p>
    <h1>{HEADLINE}</h1>
    <p class="intro">{SITE_DESCRIPTION}</p>
    <p class="filed">Filed by <span class="redact" tabindex="0">{SITE_TITLE}</span>. <a href={url('about')}>Open dossier &gt;</a></p>
  </section>

  <section>
    <div class="section-head">
      <h2 class="label">Latest records</h2>
      <a class="label" href={url('blog')}>Full archive &gt;</a>
    </div>
    <PostList posts={posts} />
  </section>
</BaseLayout>

<style>
  .hero { margin-bottom: 4.5rem; }
  .sep { color: var(--accent); }
  .intro { font-family: var(--font-serif); font-size: 1.2rem; max-width: 34rem; margin: 0 0 1rem; }
  .filed { font-size: 0.85rem; color: var(--muted); }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.75rem; }
  .section-head h2 { margin: 0; }
  .section-head a { text-decoration: none; }
  .section-head a:hover { color: var(--accent-ink); }
</style>
