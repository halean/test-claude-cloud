---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { FILED_BY, SITE_DESCRIPTION, SITE_DESCRIPTION_EN, SITE_TITLE } from '../consts';
import { getPosts, url } from '../utils';

const posts = (await getPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p class="intro" lang="vi">{SITE_DESCRIPTION}</p>
    <p class="intro-en">{SITE_DESCRIPTION_EN}</p>
    <p class="filed label">Kept by <span class="faded" tabindex="0" lang="vi">{FILED_BY}</span> · <a href={url('about')}>About</a></p>
  </section>

  <section>
    <div class="section-head">
      <h2 class="label">Recently filed</h2>
      <a class="label" href={url('blog')}>The whole archive →</a>
    </div>
    <PostList posts={posts} />
  </section>
</BaseLayout>

<style>
  .hero { margin-bottom: 4.5rem; }
  .hero h1 { max-width: 38rem; }
  .intro { font-size: 1.15rem; max-width: 34rem; margin: 0 0 0.75rem; }
  .intro-en { font-size: 0.95rem; font-style: italic; color: var(--muted); max-width: 34rem; margin: 0 0 1.25rem; }
  .filed { text-transform: none; letter-spacing: 0.04em; font-size: 0.8rem; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.75rem; }
  .section-head h2 { margin: 0; }
  .section-head a { text-decoration: none; }
  .section-head a:hover { color: var(--strong); }
</style>
