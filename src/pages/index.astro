---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPosts, url } from '../utils';

const posts = (await getPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <p class="eyebrow">Hi there 👋</p>
    <h1>I write about building software and the ideas around it.</h1>
    <p class="intro muted">{SITE_DESCRIPTION} <a href={url('about')}>More about me →</a></p>
  </section>

  <section>
    <div class="section-head">
      <h2>Recent writing</h2>
      <a href={url('blog')}>View all</a>
    </div>
    <PostList posts={posts} />
  </section>
</BaseLayout>

<style>
  .hero { margin-bottom: 4rem; }
  .eyebrow { margin: 0 0 0.75rem; font-weight: 600; color: var(--accent); }
  .intro { font-size: 1.15rem; max-width: 36rem; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.75rem; }
  .section-head h2 { margin: 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .section-head a { font-size: 0.9rem; }
</style>
