---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils';
---

<BaseLayout title="Record not found" description="This page has been removed from the record.">
  <div class="center">
    <p class="label code">Error 404 // Đứng lại! Đứng lại! Đứng lại!</p>
    <h1>This page has left the premises.</h1>
    <p class="muted">Security followed it to the edge of the car park, then stopped. Nobody else is coming.</p>
    <a href={url()}>&lt; Return to approved content</a>
  </div>
</BaseLayout>

<style>
  .center { padding: 3rem 0; }
  .code { color: var(--accent); }
</style>
