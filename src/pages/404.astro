---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils';
---

<BaseLayout title="Not found" description="This page does not exist.">
  <div class="center">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="muted">The page you're looking for moved or never existed.</p>
    <a href={url()}>← Back home</a>
  </div>
</BaseLayout>

<style>
  .center { text-align: center; padding: 4rem 0; }
  .code { font-family: var(--font-mono); color: var(--accent); font-size: 1.1rem; margin: 0; }
</style>
