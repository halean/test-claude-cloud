---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils';
---

<BaseLayout title="Forgotten" description="Nobody remembers what was here.">
  <div class="center">
    <p class="label">404 · Forgotten</p>
    <h1>Something used to be here.</h1>
    <p class="muted">Nobody remembers what. Nobody has asked in a long time.</p>
    <a href={url()}>← Back to what's left</a>
  </div>
</BaseLayout>

<style>
  .center { padding: 3rem 0; }
</style>
