---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils';
---

<BaseLayout title="Record not found" description="This page has been removed from the record.">
  <div class="center">
    <p class="label code">Error 404 // Record expunged</p>
    <h1>This page has been disappeared.</h1>
    <p class="muted">There is no record of what you're looking for. There never was.</p>
    <a href={url()}>&lt; Return to approved content</a>
  </div>
</BaseLayout>

<style>
  .center { padding: 3rem 0; }
  .code { color: var(--accent); }
</style>
